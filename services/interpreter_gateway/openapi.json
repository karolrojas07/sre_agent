{
  "openapi": "3.0.0",
  "info": {
    "title": "SRE Agent Interpreter Gateway",
    "version": "1.0.0",
    "description": "REST API for the Interpreter Agent to receive user intents."
  },
  "paths": {
    "/intent": {
      "post": {
        "summary": "Submit user intent",
        "operationId": "submitIntent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Intent accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IntentRequest": {
        "type": "object",
        "required": ["intent"],
        "properties": {
          "intent": {
            "type": "string",
            "example": "Check SLO compliance for Payment Service"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "IntentResponse": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["accepted", "processing"]
          }
        }
      }
    }
  }
}
